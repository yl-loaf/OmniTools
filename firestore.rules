rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles: Public read for leaderboards, write restricted to the owner
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['uid', 'displayName', 'contributionPoints'])
                    && request.resource.data.uid == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 100
                    && request.resource.data.contributionPoints is number;
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        // Allow point adjustments for community contributions
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contributionPoints', 'generatedCount', 'rejectedCount', 'submittedCount', 'badges', 'streakDays', 'lastActiveDate', 'updatedAt'])
      );
      allow delete: if false;
    }

    // Tool Requests: Public read, authenticated or guest create with strict validation
    match /tool_requests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId)
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 150
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 2000
                    && request.resource.data.status in ['pending', 'in_progress', 'completed', 'rejected'];
      // Allow voting or status progression
      allow update: if isSignedIn() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'voters', 'status', 'completedVersion', 'rejectionReason', 'pointsAwarded', 'updatedAt']);
      allow delete: if isSignedIn();
    }
  }
}
